CHANGEGUARD_AGENT_GATEWAY_LISTEN=127.0.0.1:18081
CHANGEGUARD_AGENT_GATEWAY_UPSTREAM=http://127.0.0.1:8080
CHANGEGUARD_AGENT_AUDIT_FILE=/opt/changeguard-agent/data/audit.jsonl
CHANGEGUARD_AGENT_AUDIT_KEY=replace-with-at-least-32-random-bytes-or-base64
CHANGEGUARD_AGENT_METRICS_FILE=/opt/changeguard-agent/data/metrics.json
CHANGEGUARD_AGENT_METRICS_TOKEN=replace-with-a-random-bearer-token
CHANGEGUARD_AGENT_MAX_BODY_BYTES=131072
CHANGEGUARD_AGENT_MAX_RESPONSE_BYTES=4194304
CHANGEGUARD_AGENT_RATE_PER_MINUTE=12
CHANGEGUARD_AGENT_RATE_BURST=4
CHANGEGUARD_AGENT_UPSTREAM_TIMEOUT=120s
CHANGEGUARD_AGENT_READY_TIMEOUT=2s
CHANGEGUARD_AGENT_SLO_P95_TARGET=30s
CHANGEGUARD_AGENT_SLO_AVAILABILITY_TARGET=99.0
CHANGEGUARD_AGENT_SLO_WINDOW=24h
CHANGEGUARD_AGENT_MONITOR_BASE_URL=http://127.0.0.1:18081
CHANGEGUARD_AGENT_MONITOR_STATE_FILE=/opt/changeguard-agent/data/monitor.json
# Optional incident webhook. Keep both values in the root-owned environment file.
CHANGEGUARD_AGENT_ALERT_WEBHOOK_URL=
CHANGEGUARD_AGENT_ALERT_WEBHOOK_TOKEN=
