# Canonical production environment for deploy/production/changeguard.service.
# Install as /etc/changeguard/core.env with root:changeguard ownership and 0640
# permissions. The production profile rejects duplicate keys, inherited
# overrides, demo-only validation, missing enterprise controls and placeholder
# values. Replace every REPLACE_ME value before running dbguard --check-config.

CHANGEGUARD_LISTEN_ADDRESS=127.0.0.1:8080
CHANGEGUARD_PUBLIC_URL=https://changeguard.example.com
CHANGEGUARD_TRUST_PROXY_HEADERS=true

CHANGEGUARD_AUTH_MODE=local
CHANGEGUARD_AUTH_SECURE_COOKIE=true
CHANGEGUARD_AUTH_SESSION_TTL=12h
CHANGEGUARD_ENABLE_DEMO_ACCOUNTS=false
CHANGEGUARD_ENABLE_DEMO_DATA=false

CHANGEGUARD_SESSION_MODE=redis
CHANGEGUARD_REDIS_URL=rediss://changeguard-session:REPLACE_ME@redis.internal.example:6379/3
CHANGEGUARD_REDIS_PREFIX=changeguard:production:session:

# The current single-instance migration path retains file state. PostgreSQL is
# the target for multi-instance production, but must receive its own migration
# and recovery rehearsal before CHANGEGUARD_STORE_MODE is changed.
CHANGEGUARD_STORE_MODE=file
CHANGEGUARD_DATA_FILE=/opt/changeguard/data/dbguard.json
CHANGEGUARD_MIGRATION_WITNESS_FILE=/opt/changeguard/data/dbguard.json.rollback-witness.json

CHANGEGUARD_EXPERIMENT_MODE=postgres
CHANGEGUARD_SHADOW_DSN=postgres://changeguard_shadow:REPLACE_ME@shadow-db.internal.example:5432/changeguard_shadow?sslmode=require
CHANGEGUARD_WORKERS=2

CHANGEGUARD_PASSPORT_HMAC_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
CHANGEGUARD_METRICS_TOKEN=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
CHANGEGUARD_OPERATIONS_WEBHOOK_TOKEN=REPLACE_ME_WITH_A_DIFFERENT_32_BYTE_TOKEN
CHANGEGUARD_OPERATIONS_ORGANIZATION_ID=REPLACE_ME_WITH_TARGET_ORGANIZATION_ID

# When CHANGEGUARD_AUTH_MODE is oidc or hybrid, also configure all four values.
# CHANGEGUARD_OIDC_ISSUER=https://idp.example.com
# CHANGEGUARD_OIDC_REDIRECT_URL=https://changeguard.example.com/auth/callback
# CHANGEGUARD_OIDC_CLIENT_ID=changeguard-production
# CHANGEGUARD_OIDC_CLIENT_SECRET=REPLACE_ME
