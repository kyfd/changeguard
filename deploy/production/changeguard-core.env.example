# Canonical production environment for deploy/production/changeguard.service.
# Install as /etc/changeguard/core.env with root:changeguard ownership and 0640
# permissions. The production profile rejects duplicate keys, inherited
# overrides, demo-only validation, missing enterprise controls and placeholder
# values. Replace every REPLACE_ME value before running dbguard --check-config.

PORT=8080
DBGUARD_PUBLIC_URL=https://changeguard.example.com
DBGUARD_TRUST_PROXY_HEADERS=true

DBGUARD_AUTH_MODE=local
DBGUARD_AUTH_SECURE_COOKIE=true
DBGUARD_AUTH_SESSION_TTL=12h
DBGUARD_ENABLE_DEMO_ACCOUNTS=false
DBGUARD_ENABLE_DEMO_DATA=false

DBGUARD_SESSION_MODE=redis
DBGUARD_REDIS_URL=rediss://changeguard-session:REPLACE_ME@redis.internal.example:6379/3

# The current single-instance migration path retains file state. PostgreSQL is
# the target for multi-instance production, but must receive its own migration
# and recovery rehearsal before DBGUARD_STORE_MODE is changed.
DBGUARD_STORE_MODE=file
DBGUARD_DATA_FILE=/opt/changeguard/data/dbguard.json
DBGUARD_MIGRATION_WITNESS_FILE=/opt/changeguard/data/dbguard.json.rollback-witness.json

DBGUARD_EXPERIMENT_MODE=postgres
DBGUARD_SHADOW_DSN=postgres://changeguard_shadow:REPLACE_ME@shadow-db.internal.example:5432/changeguard_shadow?sslmode=require
DBGUARD_WORKERS=2

DBGUARD_PASSPORT_HMAC_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
DBGUARD_METRICS_TOKEN=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
DBGUARD_OPERATIONS_WEBHOOK_TOKEN=REPLACE_ME_WITH_A_DIFFERENT_32_BYTE_TOKEN
DBGUARD_OPERATIONS_ORGANIZATION_ID=REPLACE_ME_WITH_TARGET_ORGANIZATION_ID

# When DBGUARD_AUTH_MODE is oidc or hybrid, also configure all four values.
# DBGUARD_OIDC_ISSUER=https://idp.example.com
# DBGUARD_OIDC_REDIRECT_URL=https://changeguard.example.com/auth/callback
# DBGUARD_OIDC_CLIENT_ID=changeguard-production
# DBGUARD_OIDC_CLIENT_SECRET=REPLACE_ME
