# ChangeGuard local Docker Compose demo.
# Copy to .env and replace every value marked replace-me before starting.
# Canonical names are CHANGEGUARD_*. Compose and the process still accept
# DBGUARD_* until v4.0; the server copies CHANGEGUARD_* onto unset DBGUARD_*
# keys and prints a deprecation warning for legacy-only variables.
# Production must use deploy/production/changeguard-core.env.example together
# with CHANGEGUARD_ENV_FILE / CHANGEGUARD_ENV_PROFILE=production
# (legacy DBGUARD_ENV_FILE / DBGUARD_ENV_PROFILE still work).

CHANGEGUARD_POSTGRES_PASSWORD=changeguard-local-postgres
CHANGEGUARD_PASSPORT_HMAC_SECRET=replace-me-with-at-least-32-random-bytes
CHANGEGUARD_AUTH_MODE=local
CHANGEGUARD_ENABLE_DEMO_ACCOUNTS=true
CHANGEGUARD_ENABLE_DEMO_DATA=true
CHANGEGUARD_PUBLIC_URL=http://localhost:8080
CHANGEGUARD_AUTH_SESSION_TTL=12h
CHANGEGUARD_AUTH_SECURE_COOKIE=false
CHANGEGUARD_EXPERIMENT_MODE=postgres
CHANGEGUARD_WORKERS=2

# High-privilege online upgrade execution is fail-closed. Status/version queries
# remain available; enable apply only after validating package provenance,
# backups, rollback, watcher privileges, and upgrade-directory permissions.
CHANGEGUARD_ENABLE_UPGRADE_APPLY=false

# File-store deployments only. Keep this sidecar on the same persistent volume
# as CHANGEGUARD_DATA_FILE and back up its adjacent .required marker with it.
# CHANGEGUARD_MIGRATION_WITNESS_FILE=/var/lib/changeguard/dbguard.json.rollback-witness.json

# Optional model explanation. Leave blank to use deterministic local evidence summaries.
CHANGEGUARD_LLM_BASE_URL=
CHANGEGUARD_LLM_API_KEY=
CHANGEGUARD_LLM_MODEL=deepseek-chat
CHANGEGUARD_LLM_MAX_TOKENS=700
CHANGEGUARD_LLM_DAILY_ANALYSIS_LIMIT=20
CHANGEGUARD_LLM_HTTP_TIMEOUT=15s
CHANGEGUARD_LLM_MAX_RETRIES=1
CHANGEGUARD_LLM_RETRY_BACKOFF=200ms
CHANGEGUARD_LLM_CIRCUIT_FAILURES=3
CHANGEGUARD_LLM_CIRCUIT_COOLDOWN=1m

# Optional real pipeline event receivers for local integration testing.
CHANGEGUARD_GITLAB_SIGNING_TOKEN=
CHANGEGUARD_GITLAB_WEBHOOK_SECRET=gitlab-local-webhook-secret
CHANGEGUARD_GITLAB_ORGANIZATION_ID=org_demo
CHANGEGUARD_JENKINS_WEBHOOK_TOKEN=jenkins-local-webhook-token-32-bytes
CHANGEGUARD_JENKINS_ORGANIZATION_ID=org_demo

# Independent post-release evidence receiver. Use a dedicated token that is not
# shared with Gate, Jenkins, metrics, or browser sessions.
CHANGEGUARD_OPERATIONS_WEBHOOK_TOKEN=operations-local-webhook-token-32-bytes
CHANGEGUARD_OPERATIONS_ORGANIZATION_ID=org_demo

# Optional protected metrics endpoint.
CHANGEGUARD_METRICS_TOKEN=
