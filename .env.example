# ChangeGuard local Docker Compose demo.
# Copy to .env and replace every value marked replace-me before starting.

DBGUARD_POSTGRES_PASSWORD=changeguard-local-postgres
DBGUARD_PASSPORT_HMAC_SECRET=replace-me-with-at-least-32-random-bytes
DBGUARD_AUTH_MODE=local
DBGUARD_ENABLE_DEMO_ACCOUNTS=true
DBGUARD_ENABLE_DEMO_DATA=true
DBGUARD_PUBLIC_URL=http://localhost:8080
DBGUARD_AUTH_SESSION_TTL=12h
DBGUARD_AUTH_SECURE_COOKIE=false
DBGUARD_EXPERIMENT_MODE=postgres

# Optional model explanation. Leave blank to use deterministic local evidence summaries.
DBGUARD_LLM_BASE_URL=
DBGUARD_LLM_API_KEY=
DBGUARD_LLM_MODEL=deepseek-chat
DBGUARD_LLM_MAX_TOKENS=700
DBGUARD_LLM_DAILY_ANALYSIS_LIMIT=20
DBGUARD_LLM_HTTP_TIMEOUT=15s
DBGUARD_LLM_MAX_RETRIES=1
DBGUARD_LLM_RETRY_BACKOFF=200ms
DBGUARD_LLM_CIRCUIT_FAILURES=3
DBGUARD_LLM_CIRCUIT_COOLDOWN=1m

# Optional real pipeline event receivers for local integration testing.
DBGUARD_GITLAB_SIGNING_TOKEN=
DBGUARD_GITLAB_WEBHOOK_SECRET=gitlab-local-webhook-secret
DBGUARD_GITLAB_ORGANIZATION_ID=org_demo
DBGUARD_JENKINS_WEBHOOK_TOKEN=jenkins-local-webhook-token-32-bytes
DBGUARD_JENKINS_ORGANIZATION_ID=org_demo

# Independent post-release evidence receiver. Use a dedicated token that is not
# shared with Gate, Jenkins, metrics, or browser sessions.
DBGUARD_OPERATIONS_WEBHOOK_TOKEN=operations-local-webhook-token-32-bytes
DBGUARD_OPERATIONS_ORGANIZATION_ID=org_demo

# Optional protected metrics endpoint.
DBGUARD_METRICS_TOKEN=
